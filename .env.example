# ==============================================================================
# QueueMind Environment Configuration
# Copy this file to .env and configure local directory paths and settings.
# Do NOT commit .env to version control.
# ==============================================================================

# Path to the raw MIMIC-IV-ED dataset directory (contains edstays, vitalsign, etc.)
MIMIC_DATA_DIR=data/raw

# Path where validated and processed feature tables will be cached
PROCESSED_DATA_DIR=data/processed

# Application Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Runtime environment (development, staging, production)
ENVIRONMENT=development
